<?xml version="1.0" ?>
<robot name="truck" xmlns:xacro="http://www.ros.org/wiki/xacro" >

<xacro:arg name="steering_limit" default="${35 * pi / 180}"/>
<xacro:arg name="suspension" default="rigid"/>
<xacro:arg name="scene" default="flat"/>

<!-- argument to specify whether a Gazebo or MuJoCo simulation shall be launched -->
<xacro:arg name="sim_type" default="gazebo" />

<ros2_control name="Truck8x8Control" type="system">
    <hardware>
        <xacro:if value="${'$(arg sim_type)' == 'gazebo'}">
            <plugin>gz_ros2_control/GazeboSimSystem</plugin>
        </xacro:if>

        <xacro:if value="${'$(arg sim_type)' == 'mujoco'}">
            <plugin>mujoco_ros2_control/MujocoSystemInterface</plugin>
            <param name="mujoco_model">$(find mjcf)/models/mujoco_scene_$(arg scene).xml</param>

            <!-- Uncomment this to use the keyframe from shown file as the starting configuration. -->
            <!-- <param name="override_start_position_file">$(find mujoco_ros2_control_demos)/config/start_positions.xml</param> -->

            <!-- Override the slowdown settings in the Simulate App and run at 3x speed -->
            <param name="sim_speed_factor">1.0</param>

            <!-- Uncomment to start the simulation at a specific keyframe defined in the MJCF -->
            <!-- <param name="initial_keyframe">start_90</param> -->

            <!-- If set to true, will not launch the Simulate App window -->
            <param name="headless">$(arg headless)</param>
        </xacro:if>
    </hardware>

    <!-- if suspension model == roll, publish the joint state of roll joint as well -->
    <xacro:if value="${'$(arg suspension)' == 'roll'}">
        <joint name="roll_joint">
            <state_interface name="position"/>
            <state_interface name="velocity"/>
        </joint>
    </xacro:if>

    <joint name="left_steer_joint_a2">
        <command_interface name="position">
            <param name="min">-$(arg steering_limit)</param>
            <param name="max">$(arg steering_limit)</param>
        </command_interface>
        <state_interface name="position"/>
    </joint>

    <joint name="right_steer_joint_a2">
        <command_interface name="position">
            <param name="min">-$(arg steering_limit)</param>
            <param name="max">$(arg steering_limit)</param>
        </command_interface>
        <state_interface name="position"/>
    </joint>

    <joint name="left_steer_joint_a1">
        <command_interface name="position">
            <param name="min">-$(arg steering_limit)</param>
            <param name="max">$(arg steering_limit)</param>
        </command_interface>
        <state_interface name="position"/>
    </joint>

    <joint name="right_steer_joint_a1">
        <command_interface name="position">
            <param name="min">-$(arg steering_limit)</param>
            <param name="max">$(arg steering_limit)</param>
        </command_interface>
        <state_interface name="position"/>
    </joint>

    <joint name="left_rot_joint_a4">
        <command_interface name="velocity"/>
        <state_interface name="velocity"/>
        <state_interface name="position"/>
        <state_interface name="effort"/>
    </joint>

    <joint name="right_rot_joint_a4">
        <command_interface name="velocity"/>
        <state_interface name="velocity"/>
        <state_interface name="position"/>
        <state_interface name="effort"/>
    </joint>

    <joint name="left_rot_joint_a3">
        <command_interface name="velocity"/>
        <state_interface name="velocity"/>
        <state_interface name="position"/>
        <state_interface name="effort"/>
    </joint>

    <joint name="right_rot_joint_a3">
        <command_interface name="velocity"/>
        <state_interface name="velocity"/>
        <state_interface name="position"/>
        <state_interface name="effort"/>
    </joint>

    <xacro:if value="${'$(arg sim_type)' == 'mujoco'}">
        <sensor name="camera">
            <!-- Parameters will be used as is -->
            <param name="frame_name">camera_color_mujoco_frame</param>
            <param name="info_topic">/camera/color/camera_info</param>
            <param name="image_topic">/camera/color/image_raw</param>
            <param name="depth_topic">/camera/aligned_depth_to_color/image_raw</param>
        </sensor>

        <!-- WARNING: These lidar sensors are deprecated, including for test and legacy support only! -->
        <sensor name="lidar">
            <param name="frame_name">lidar_sensor_frame</param>
            <param name="angle_increment">0.025</param>
            <param name="min_angle">-0.3</param>
            <param name="max_angle">0.3</param>
            <param name="range_min">0.05</param>
            <param name="range_max">10</param>
            <param name="laserscan_topic">/scan</param>
        </sensor>  
    </xacro:if>
</ros2_control>

</robot>