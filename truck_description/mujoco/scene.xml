<mujoco model="truck_simulation_scene">
    <compiler angle="degree" coordinate="local" meshdir="../meshes/"/>
    <option timestep="0.002" integrator="implicitfast" gravity="0 0 -9.81"/>

    <visual>
        <headlight ambient="0.4 0.4 0.4" diffuse="0.8 0.8 0.8" specular="0.1 0.1 0.1"/>
        <rgba skybox="0.4 0.6 0.8 1"/>
    </visual>

    <asset>
        <texture name="grid" type="2d" builtin="checker" rgb1=".1 .2 .3" rgb2=".2 .3 .4" width="300" height="300" mark="edge" markrgb=".2 .3 .4"/>
        <material name="grid_material" texture="grid" texrepeat="2 2" texuniform="true"/>
    </asset>

    <worldbody>
        <light pos="0 0 10" dir="0 0 -1" directional="true" castshadow="true"/>

        <geom name="floor" type="plane" size="0 0 .25" material="grid_material" condim="3"/>

        </worldbody>

    <extension>
        <plugin plugin="mujoco_ros2_control"/>
    </extension>
</mujoco>
